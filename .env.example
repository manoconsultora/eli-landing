# Retrieve your GA ID from your GA dashboard
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXX

# n8n webhook for the CTA chat module
N8N_ELI_WEBHOOK_URL=https://your-n8n-instance/webhook/eli-cta-chat-modulo-landing
N8N_ELI_WEBHOOK_SECRET=required-shared-secret

# Server-only Supabase connection. Never expose the service-role key to the browser.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Generate independent random values for each secret.
PAYMENTS_IDEMPOTENCY_SECRET=
PAYMENTS_STATUS_TOKEN_SECRET=
ELI_INTERNAL_JOBS_SECRET=
ELI_PUBLIC_BASE_URL=http://localhost:3000

# Mercado Pago TEST only for local/Human TEST gate.
MP_PROVIDER_MODE=mercadopago
MP_ACCESS_TOKEN=
MP_ENVIRONMENT=test
# Exact public HTTPS receiver passed as notification_url when POST /preapproval
# creates the subscription. Do not source a secret from the global Webhooks panel.
MP_NOTIFICATION_URL=https://test-webhooks.example.com/api/payments/webhooks/mercadopago
NEXT_PUBLIC_MP_PUBLIC_KEY=
NEXT_PUBLIC_MP_ENVIRONMENT=test
# MP_SUBSCRIPTION_PLAN_ID is not global: each TEST/production ID is stored in
# payment_plan_versions through a reviewed canonical DB migration.

# Local deterministic QA only. Forbidden by the server in production.
# MP_PROVIDER_MODE=stub
# NEXT_PUBLIC_MP_STUB_MODE=true

# ELI Desk destination; Desk still enforces its own auth/tenant state.
NEXT_PUBLIC_ELI_DESK_URL=http://localhost:3001

# Disabled by default. Enabling and supplying production values is a Human Gate.
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=

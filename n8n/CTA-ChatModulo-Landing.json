ing:28px 28px 18px;text-align:center;background:#ffffff;\">\n        <img src=\"${logoUrl}\" alt=\"ELI Desk\" width=\"72\" height=\"72\" style=\"display:block;margin:0 auto 12px;\" />\n        <div style=\"font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#7a819f;\">ELI Desk</div>\n        <h1 style=\"margin:10px 0 0;font-size:28px;line-height:1.15;color:#2f3159;\">Recibimos tu mensaje</h1>\n      </div>\n      <div style=\"padding:0 28px 28px;\">\n        <p style=\"margin:0 0 16px;font-size:16px;line-height:1.7;\">Hola,</p>\n        <p style=\"margin:0 0 16px;font-size:16px;line-height:1.7;\">Recibimos tu consulta como <strong>${item.visitorType}</strong>. A la brevedad será revisada y respondida por nuestro equipo.</p>\n        <div style=\"margin:22px 0;padding:18px 20px;border-radius:18px;background:#f8fafc;border:1px solid #e7ebf3;\">\n          <div style=\"font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:#7a819f;margin-bottom:8px;\">Tu mensaje</div>\n          <div style=\"font-size:15px;line-height:1.7;color:#2f3159;white-space:pre-wrap;\">${safePreview}</div>\n        </div>\n        <p style=\"margin:0 0 12px;font-size:15px;line-height:1.7;color:#4f5675;\">Si necesitás ampliar la información, podés responder este mismo correo.</p>\n        <p style=\"margin:22px 0 0;font-size:15px;line-height:1.7;color:#2f3159;\">Gracias por contactarte con <strong>ELI Desk</strong>.</p>\n      </div>\n      ${footerHtml}\n    </div>\n  </div>`;\nreturn [{ json: item }];"

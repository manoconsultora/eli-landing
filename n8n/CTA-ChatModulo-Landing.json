      ],
      "webhookId": "eli-cta-chat-modulo-landing"
    },
    {
      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\nconst prompt = (input.prompt ?? '').trim();\nconst category = (input.category ?? '').trim();\nconst email = (input.email ?? '').trim().toLowerCase();\nconst allowed = ['Soy Administrador', 'Soy vecino', 'Soy inversor'];\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nif (!prompt) {\n  throw new Error('La consulta está vacía.');\n}\n\nif (!allowed.includes(category)) {\n  throw new Error('Tipo de visitante inválido.');\n}\n\nif (!emailRegex.test(email)) {\n  throw new Error('Email inválido.');\n}\n\nconst preview = prompt.replace(/\\s+/g, ' ').slice(0, 240);\n\nreturn [{\n  json: {\n    source: input.source ?? 'landing-cta',\n    prompt,\n    category,\n    email,\n    preview,\n    submittedAt: input.submittedAt ?? new Date().toISOString(),\n    referrer: input.referrer ?? $json.headers?.referer ?? '',\n    userAgent: input.userAgent ?? $json.headers?.['user-agent'] ?? '',\n    internalRecipients: ['martin@ma-no.work'],\n    confirmationSubject: 'ELI DESK - recibimos tu mensaje'\n  }\n}];"
      },
